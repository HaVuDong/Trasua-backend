PORT=3000
MONGODB_URI=mongodb://localhost:27017/trasua
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
USE_REDIS_MOCK=false
DISABLE_REDIS_QUEUE=false
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=trasua
S3_USE_SSL=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM="TraSua POS <no-reply@example.com>"
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=8000
# Resend API (recommended for cloud deployment where SMTP ports are blocked)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
RESEND_TEST_TO=

# Local demo only. Production ignores these unless ALLOW_PRODUCTION_DEVICE_OTP_BYPASS=true.
DISABLE_DEVICE_OTP=false
AUTH_DISABLE_DEVICE_OTP=false
ALLOW_PRODUCTION_DEVICE_OTP_BYPASS=false
